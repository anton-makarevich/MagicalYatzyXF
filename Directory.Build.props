<?xml version="1.0" encoding="utf-8"?>
<Project>
    <PropertyGroup>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == '' and '$(CI)' == 'true'">true</ContinuousIntegrationBuild>
        <VersionPrefix>2.6.1</VersionPrefix>
        <!-- Relay defaults are embedded in the Core assembly; they are extractable and must not be treated as secrets. Pass -p:RelayBaseUrl=... and -p:RelayApiKey=... at build time. Empty values fall back to http://localhost:8080 and an empty API key. -->
        <RelayBaseUrl></RelayBaseUrl>
        <RelayApiKey></RelayApiKey>
        <!-- Single source of truth for the Avalonia Developer Tools version (global 'avdt' tool and the Debug-only AvaloniaUI.DiagnosticsSupport package). Keep both in sync with the installed tool. -->
        <AvaloniaDevToolsVersion>2.2.3</AvaloniaDevToolsVersion>
        <!-- Single source of truth for all core Avalonia packages (shared by all projects). -->
        <AvaloniaVersion>12.1.3</AvaloniaVersion>
        <Authors>Anton Makarevich</Authors>
        <Company>Anton Makarevich</Company>
        <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <VersionPrefixMajor>$([System.Version]::Parse('$(VersionPrefix)').Major)</VersionPrefixMajor>
        <VersionPrefixMinor>$([System.Version]::Parse('$(VersionPrefix)').Minor)</VersionPrefixMinor>
        <VersionPrefixBuild>$([System.Version]::Parse('$(VersionPrefix)').Build)</VersionPrefixBuild>
        <StoreVersionCode>$([System.Convert]::ToInt32($([System.String]::Format('{0:0000}{1:00}{2:00}', $([System.Version]::Parse('$(VersionPrefix)').Major), $([System.Version]::Parse('$(VersionPrefix)').Minor), $([System.Version]::Parse('$(VersionPrefix)').Build)))))</StoreVersionCode>
    </PropertyGroup>

    <Target Name="ValidateStoreVersionCodeWidths" BeforeTargets="PrepareForBuild"
            Condition="$(VersionPrefixMajor) &gt; 9999 or $(VersionPrefixMinor) &gt; 99 or $(VersionPrefixBuild) &gt; 99">
        <Error Code="MY0001"
               Text="VersionPrefix '$(VersionPrefix)' has a component exceeding the positional width of StoreVersionCode (Major at most 9999, Minor at most 99, Build at most 99). Adjust the width layout in Directory.Build.props so StoreVersionCode stays monotonic and collision-free." />
    </Target>

    <!-- Invoked from `mise run install-devtools`; update||install keeps a missing/fresh global tool working. -->
    <Target Name="InstallAvaloniaDevTools">
        <Exec Command="dotnet tool update --global AvaloniaUI.DeveloperTools --version $(AvaloniaDevToolsVersion) --allow-downgrade || dotnet tool install --global AvaloniaUI.DeveloperTools --version $(AvaloniaDevToolsVersion)" />
    </Target>
</Project>
