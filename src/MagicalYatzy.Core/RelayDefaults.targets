<Project>

    <!--
      Generates RelayDefaults.g.cs with the build-time-embedded relay defaults.
      Values arrive as global MSBuild properties (-p:RelayBaseUrl / -p:RelayApiKey).
      When unset (local development), the constants are emitted as null and
      RelayDefaults falls back to http://localhost:8080 and an empty API key.
    -->
    <Target Name="GenerateRelayDefaults" BeforeTargets="CoreCompile">
        <PropertyGroup>
            <RelayDefaultsFile>$([System.IO.Path]::Combine('$(IntermediateOutputPath)', 'generated', 'RelayDefaults.g.cs'))</RelayDefaultsFile>
            <_RelayBaseUrlLiteral Condition="'$(RelayBaseUrl)' == ''">null</_RelayBaseUrlLiteral>
            <_RelayBaseUrlLiteral Condition="'$(RelayBaseUrl)' != ''">"$(RelayBaseUrl)"</_RelayBaseUrlLiteral>
            <_RelayApiKeyLiteral Condition="'$(RelayApiKey)' == ''">null</_RelayApiKeyLiteral>
            <_RelayApiKeyLiteral Condition="'$(RelayApiKey)' != ''">"$(RelayApiKey)"</_RelayApiKeyLiteral>
        </PropertyGroup>

        <ItemGroup>
            <_RelayDefaultsLine Include="// &lt;auto-generated&gt; Generated by GenerateRelayDefaults target - do not edit." />
            <_RelayDefaultsLine Include="// &lt;/auto-generated&gt;" />
            <_RelayDefaultsLine Include=" " />
            <_RelayDefaultsLine Include="namespace Sanet.MagicalYatzy.Services.Relay%3B" />
            <_RelayDefaultsLine Include=" " />
            <_RelayDefaultsLine Include="public static partial class RelayDefaults" />
            <_RelayDefaultsLine Include="{" />
            <_RelayDefaultsLine Include="    internal const string%3F BuildTimeBaseUrl = $(_RelayBaseUrlLiteral)%3B" />
            <_RelayDefaultsLine Include=" " />
            <_RelayDefaultsLine Include="    internal const string%3F BuildTimeApiKey = $(_RelayApiKeyLiteral)%3B" />
            <_RelayDefaultsLine Include="}" />
        </ItemGroup>

        <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(RelayDefaultsFile)'))" />
        <WriteLinesToFile File="$(RelayDefaultsFile)"
                          Lines="@(_RelayDefaultsLine)"
                          Overwrite="true"
                          WriteOnlyWhenDifferent="true" />

        <ItemGroup>
            <Compile Include="$(RelayDefaultsFile)" Link="Services\Relay\RelayDefaults.g.cs" />
            <FileWrites Include="$(RelayDefaultsFile)" />
        </ItemGroup>
    </Target>

</Project>
