<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Sanet.MagicalYatzy.ViewModels;assembly=MagicalYatzy.Core"
             xmlns:fragments="clr-namespace:Sanet.MagicalYatzy.Avalonia.Views.Fragments"
             xmlns:templatedControls="clr-namespace:Sanet.MagicalYatzy.Avalonia.Views.TemplatedControls"
             x:Class="Sanet.MagicalYatzy.Avalonia.Views.OnlineLobby.OnlineLobbyViewWide"
             x:DataType="viewModels:OnlineLobbyViewModel">
    <Grid Margin="0" RowDefinitions="Auto,*,Auto">
        <templatedControls:ToolBar Grid.Row="0"
            LeftCommand="{Binding BackCommand}"
            LeftIcon="{Binding BackImage}"
            Title="{Binding Title}"
            TitleAlignment="Center" />
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="24" Margin="10">
                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto" VerticalAlignment="Top">
                    <StackPanel Spacing="8">
                        <templatedControls:EditableMenuItem
                            Caption="{Binding CurrentPlayerName, Mode=TwoWay}"
                            Description="{Binding CurrentPlayerTypeName}"
                            ImageSource="{Binding CurrentPlayerImage}" />
                        <ToggleSwitch IsVisible="{Binding IsModeSelectionVisible}"
                                      IsChecked="{Binding IsCreateMode, Mode=TwoWay}"
                                      OnContent="{Binding HostGameLabel}"
                                      OffContent="{Binding JoinGameLabel}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="8" Margin="0,12">
                        <TextBlock Text="{Binding RoomCodeLabel}" FontWeight="Bold" />
                        <TextBlock Text="{Binding RoomCode}" FontSize="28" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                        <Button Content="{Binding CopyCodeLabel}" Command="{Binding CopyCodeCommand}" IsVisible="{Binding IsHosting}" />
                    </StackPanel>
                    <fragments:OnlineRoomsFragment Grid.Row="2" Margin="0,12" />
                </Grid>
                <Grid Grid.Column="1" RowDefinitions="Auto,*" VerticalAlignment="Top">
                    <Label Content="{Binding RulesTitle}" Classes="caption" HorizontalAlignment="Left" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Rules}"
                             SelectedItem="{Binding SelectedRule}"
                             IsEnabled="{Binding IsRulesEditable}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <templatedControls:MainMenuItem
                                    Caption="{Binding Name}"
                                    Description="{Binding ShortDescription}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
            <templatedControls:ActionButton Content="{Binding CreateRoomLabel}" Command="{Binding CreateRoomCommand}" IsVisible="{Binding IsHostSetup}" ImageSource="{Binding StartImage}" />
            <templatedControls:ActionButton Content="{Binding JoinGameLabel}" Command="{Binding JoinCommand}" IsVisible="{Binding IsJoinSetup}" IsEnabled="{Binding CanJoin}" ImageSource="{Binding StartImage}" />
            <templatedControls:ActionButton Content="{Binding ReadyLabel}" Command="{Binding ReadyCommand}" IsVisible="{Binding CanReady}" ImageSource="{Binding StartImage}" />
            <templatedControls:ActionButton Content="{Binding StartLabel}" Command="{Binding StartGameCommand}" IsVisible="{Binding CanStartGame}" ImageSource="{Binding StartImage}" />
        </StackPanel>
    </Grid>
</UserControl>
