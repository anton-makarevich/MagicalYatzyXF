<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Sanet.MagicalYatzy.ViewModels;assembly=MagicalYatzy.Core"
             xmlns:fragments="clr-namespace:Sanet.MagicalYatzy.Avalonia.Views.Fragments"
             xmlns:templatedControls="clr-namespace:Sanet.MagicalYatzy.Avalonia.Views.TemplatedControls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="600"
             x:DataType="viewModels:SettingsViewModel"
             x:Class="Sanet.MagicalYatzy.Avalonia.Views.Settings.SettingsViewWide">
    <Grid RowDefinitions="Auto,*">
        <templatedControls:ToolBar
            Grid.Row="0"
            LeftCommand="{Binding BackCommand}"
            LeftIcon="{Binding BackImage}"
            Title="{Binding Title}"
            HorizontalAlignment="Left"
            Grid.ColumnSpan="3"
        />
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="*,*" Margin="40,15">
                <StackPanel Grid.Column="0">
                    <fragments:GameSettingsFragment />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                    <Label Content="{Binding HubSectionTitle}" Classes="caption"/>
                    <fragments:HubConfigurationFragment />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
