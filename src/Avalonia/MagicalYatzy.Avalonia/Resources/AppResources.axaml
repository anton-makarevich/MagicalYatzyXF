<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >
    
    <Color x:Key = "SanetBlueColor">#009CD6</Color>
    <Color x:Key = "MenuSelectionColor">#41009CD6</Color>
    <Color x:Key="GoldBackColor">#FFF7A30D</Color>
    <Color x:Key="SilverBackColor">#FF8B8B8B</Color>
    <Color x:Key="BronzeBackColor">#FF9D5509</Color>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="TextForegroundBrush" Color="White"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="TextForegroundBrush" Color="Black"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="ScrimBrush" Color="#33000000"/>

    <x:Int16 x:Key = "ToolButtonSize">32</x:Int16>
    <x:Double x:Key = "MenuCellSize">70</x:Double>
    <GridLength x:Key = "MenuCellGridSize">70</GridLength>
    
    <x:Double x:Key = "RollResultCellSize">80</x:Double>
    <x:Double x:Key = "RollResultCellSizeCompact">60</x:Double>

    <GridLength x:Key = "ProfilePicSize">50</GridLength>
    <x:Double x:Key = "ProfilePicSizeValue">50</x:Double>
    <GridLength x:Key = "ToolBarHeight">50</GridLength>
    <GridLength x:Key = "ToolButtonGridSize">32</GridLength>
    <x:Double x:Key = "GameButtonsWidth">60</x:Double>
</ResourceDictionary>
