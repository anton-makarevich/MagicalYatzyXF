<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-android</TargetFramework>
        <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
        <ApplicationId>nl.sanetby.magicalyatzy</ApplicationId>
        <ApplicationVersion>$(StoreVersionCode)</ApplicationVersion>
        <ApplicationDisplayVersion>$(VersionPrefix)</ApplicationDisplayVersion>
        <AndroidPackageFormat>apk</AndroidPackageFormat>
        <RootNamespace>Sanet.MagicalYatzy.Avalonia.Android</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <AndroidResource Include="Icon.png">
            <Link>Resources\drawable\Icon.png</Link>
        </AndroidResource>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
        <PackageReference Include="Sanet.MVVM.DI.Avalonia" Version="1.7.1211" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MagicalYatzy.Avalonia\MagicalYatzy.Avalonia.csproj" />
    </ItemGroup>
</Project>

