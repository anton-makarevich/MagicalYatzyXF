<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
    <PropertyGroup>
        <TargetFramework>net9.0-browser</TargetFramework>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <WasmMainJSPath>AppBundle\main.js</WasmMainJSPath>
        <OutputType>Exe</OutputType>
        <RootNamespace>Sanet.MagicalYatzy.Avalonia.Browser</RootNamespace>
        <InvariantGlobalization>false</InvariantGlobalization>
        <PublishTrimmed>false</PublishTrimmed>
        <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
        <AssemblyName>MagicalYatzy.Avalonia.Browser</AssemblyName>
        <LangVersion>13</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <TrimmerRootAssembly Include="MagicalYatzy" />
        <TrimmerRootAssembly Include="MagicalYatzy.Dto" />
        <TrimmerRootAssembly Include="MagicalYatzy.Avalonia" />
    </ItemGroup>

    <ItemGroup>
        <WasmExtraFilesToDeploy Include="AppBundle\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Browser" Version="11.2.1" />
        <PackageReference Include="Sanet.MVVM.DI.Avalonia" Version="1.1.1.1113" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MagicalYatzy.Avalonia\MagicalYatzy.Avalonia.csproj" />
    </ItemGroup>
</Project>
